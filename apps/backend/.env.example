PORT=3333
DATABASE_URL=postgres://taskflow:taskflow@localhost:5432/taskflow
CORS_ORIGIN=http://localhost:5173

# URL do frontend, usada para montar o link de redefinição de senha
APP_URL=http://localhost:5173

SESSION_TTL_HOURS=168
RESET_TOKEN_TTL_MINUTES=60

# SMTP (o docker-compose sobe o Mailpit em localhost:1025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TaskFlow <nao-responda@taskflow.local>"
